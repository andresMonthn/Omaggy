{
  "name": "omaggy-desktop",
  "productName": "Omaggy",
  "version": "1.0.0",
  "description": "Desktop Application for Omaggy",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-packager . --out=dist --overwrite",
    "dist": "electron-builder",
    "test:stt": "node stt/tests/transcribe.test.js",
    "test:audio": "set OMAGGY_AUDIO_TEST=1&& electron .",
    "test:stt:ui": "set OMAGGY_STT_UI_TEST=1&& electron ."
  },
  "author": "Omaggy",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "@electron/packager": "^18.3.5"
  },
  "build": {
    "appId": "com.omaggy.desktop",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "audio/**/*",
      "stt/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "directories": {
      "output": "dist-builder"
    }
  }
}
